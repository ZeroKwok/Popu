{
  "version": "1.0",
  "mode": "dialog",
  "template": "confirm",
  "position": "cursor_screen_center",
  "window": {
    "screen": "primary",
    "area": "screen",
    "width": "100%",
    "height": "100%"
  },
  "content": {
    "severity": "info",
    "title": "Physical-screen fullscreen test",
    "message": "This dialog fills the primary monitor's physical screen, including the taskbar area."
