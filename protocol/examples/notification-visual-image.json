{
  "version": "1.0", "mode": "notify", "template": "notification",
  "duration_ms": 12000, "window": { "width": 440, "height": 330 },
  "content": {
    "severity": "success", "title": "Inline SVG snapshot", "vertical_align": "start",
    "blocks": [
      {
        "type": "image", "height": 170,
        "source": { "src": "data:image/svg+xml;base64,", "alt": "Blue illustrative trend drawn as a standalone SVG" },
        "caption": "Self-contained image; remains available in notification history."
      },
      { "type": "paragraph", "text": "The same image block accepts PNG, JPEG and WebP base64 sources." }
    ]
  }
}
