{
  "version": "1.0",
  "mode": "dialog",
  "template": "confirm",
  "position": "cursor_screen_center",
  "window": {
    "always_on_top": true,
    "width": 560,
    "height": 680
  },
  "content": {
    "severity": "warning",
    "vertical_align": "start",
    "title": "Review the planned changes before continuing",
    "blocks": [
      {
        "text": "This intentionally long message verifies wrapping, selection, and the card\u0027s fixed 9px transparent shadow inset. It describes several operations so the message occupies multiple lines at ordinary desktop widths. The action area must remain reachable and the visual edge must stay consistent on every side of the WebView.",
        "type": "paragraph"
      },
      {
        "items": [
          {
            "label": "Source",
            "text": "H:\\Automation\\Incoming\\very-long-source-folder-name"
          },
          {
            "label": "Destination",
            "text": "D:\\Backup\\2026\\August\\validated-output"
          },
          {
            "label": "Items",
            "text": "1,248 files and 37 folders"
          },
          {
            "label": "Policy",
            "text": "Existing files will be replaced after confirmation"
          }
        ],
        "type": "properties"
      },
      {
        "type": "form",
        "title": "Confirmation",
        "fields": [
          {
            "id": "note",
            "type": "textarea",
            "label": "",
            "placeholder": "Leave an audit note"
          },
          {
            "id": "confirmed",
            "type": "checkbox",
            "label": "I understand the replacement operation",
            "required": true
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "id": "continue",
      "label": "Continue",
      "style": "danger",
      "submit": true
    },
    {
      "id": "cancel",
      "label": "Cancel",
      "style": "secondary",
      "result_status": "cancelled"
    }
  ],
  "timeout_seconds": 300
}
