{
  "version": "1.0", "mode": "dialog", "template": "form",
  "window": { "width": 740, "height": 620 },
  "content": {
    "severity": "info", "title": "Review service latency", "vertical_align": "start",
    "blocks": [
      { "type": "paragraph", "text": "Synthetic service measurements. Charts and form fields share the same dialog renderer." },
      {
        "type": "chart", "engine": "vega_lite", "height": 280,
        "spec": {
          "data": { "values": [{"service":"Gateway","ms":42},{"service":"Sync","ms":115},{"service":"Backup","ms":78},{"service":"History","ms":26}] },
          "mark": { "type": "bar", "color": "#377dff", "cornerRadiusTopLeft": 4, "cornerRadiusTopRight": 4 },
          "encoding": {
            "x": { "field": "service", "type": "nominal", "axis": { "title": null, "labelAngle": 0 } },
            "y": { "field": "ms", "type": "quantitative", "axis": { "title": "Latency (ms)" } }
          }
        }
      },
      { "type": "form", "fields": [{ "id": "reviewed", "type": "checkbox", "label": "I have reviewed these measurements", "required": true }] }
    ]
  },
  "actions": [
    { "id": "confirm", "label": "Confirm review", "submit": true },
    { "id": "cancel", "label": "Cancel", "style": "secondary", "result_status": "cancelled" }
  ]
}
