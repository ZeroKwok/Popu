{
    "version": "1.0",
    "mode": "dialog",
    "template": "confirm",
    "position": "cursor_screen_center",
    "window": {
        "screen": "primary",
        "area": "screen",
        "width": "100%",
        "height": "100%"
    },
    "content": {
        "severity": "info",
        "title": "Physical-screen fullscreen test",
        "blocks": [
            {
                "text": "This dialog fills the primary monitor\u0027s physical screen, including the taskbar area.",
                "type": "paragraph"
            }
        ]
    },
    "actions": [
        {
            "id": "close",
            "label": "Close",
            "style": "secondary",
            "result_status": "closed"
        }
    ],
    "timeout_seconds": 300
}