{
    "version": "1.0",
    "mode": "dialog",
    "template": "confirm",
    "position": "cursor_screen_center",
    "window": {
        "always_on_top": true,
        "width": 320,
        "height": 220
    },
    "content": {
        "severity": "info",
        "title": "操作完成",
        "blocks": [
            {
                "text": "所有任务均已成功!",
                "type": "paragraph"
            }
        ]
    },
    "actions": [
        {
            "id": "ok",
            "label": "OK",
            "style": "primary",
            "result_status": "confirmed"
        }
    ],
    "timeout_seconds": 300
}
