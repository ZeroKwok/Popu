{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Popu Host configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edge_margin_px": { "$ref": "#/$defs/spacing" },
        "gap_px": { "$ref": "#/$defs/spacing" },
        "max_visible": { "type": "integer", "minimum": 1, "maximum": 16 },
        "default_width_px": { "$ref": "#/$defs/dimension" },
        "auto_min_height_px": { "$ref": "#/$defs/dimension" },
        "auto_max_height_px": { "$ref": "#/$defs/dimension" },
        "fallback_height_px": { "$ref": "#/$defs/dimension" },
        "default_duration_ms": { "type": "integer", "minimum": 500, "maximum": 86400000 },
        "idle_timeout_seconds": { "type": "integer", "minimum": 60, "maximum": 2592000 },
        "max_user_reshows": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "dialog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_width_px": { "$ref": "#/$defs/dimension" },
        "auto_min_height_px": { "$ref": "#/$defs/dimension" },
        "auto_max_height_px": { "$ref": "#/$defs/dimension" },
        "fallback_height_px": { "$ref": "#/$defs/dimension" },
        "default_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_entries": { "type": "integer", "minimum": 50, "maximum": 5000 }
      }
    }
  },
  "$defs": {
    "spacing": { "type": "integer", "minimum": 0, "maximum": 256 },
    "dimension": { "type": "integer", "minimum": 1, "maximum": 8192 }
  }
}
