{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://popu.dev/schema/popu-1.0.json",
  "title": "Popu request",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode", "content"],
  "properties": {
    "version": { "const": "1.0" },
    "mode": { "enum": ["dialog", "notify"] },
    "coalesce_key": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "template": { "type": "string", "minLength": 1 },
    "position": { "enum": ["bottom_right", "cursor_screen_center"] },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "always_on_top": { "type": "boolean" },
        "screen": { "enum": ["cursor", "primary"] },
        "area": { "enum": ["work_area", "screen"] },
        "width": { "$ref": "#/$defs/windowDimension" },
        "height": { "$ref": "#/$defs/windowDimension" }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "severity": { "enum": ["info", "success", "warning", "error"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
        "icon": { "$ref": "#/$defs/imageSource" },
        "vertical_align": { "enum": ["start", "center"], "default": "center" },
        "blocks": { "type": "array", "default": [], "items": { "$ref": "#/$defs/contentBlock" } }
      }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "duration_ms": { "type": "integer", "minimum": 500, "maximum": 86400000 },
    "requires_read": { "type": "boolean", "default": false, "description": "Require reading this notification; unread history keeps the tray reminder active." }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "dialog" } } },
      "then": { "required": ["actions"], "not": { "required": ["requires_read"] } },
      "else": {
        "properties": {
          "actions": { "maxItems": 0 },
          "content": {
            "properties": {
              "blocks": {
                "items": {
                  "not": {
                    "required": ["type"],
                    "properties": { "type": { "const": "form" } }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "imageSource": {
      "type": "object", "additionalProperties": false, "required": ["src", "alt"],
      "properties": {
        "src": { "type": "string", "maxLength": 262144, "pattern": "^data:image/(?:svg\\+xml|png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$" },
        "alt": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" }
      }
    },
    "blockTitle": { "type": "string", "maxLength": 200 },
    "blockText": { "type": "string", "minLength": 1, "maxLength": 20000, "pattern": "\\S" },
    "propertyItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "maxLength": 200 },
        "text": { "type": "string", "maxLength": 20000 }
      },
      "anyOf": [
        { "required": ["label"], "properties": { "label": { "pattern": "\\S" } } },
        { "required": ["text"], "properties": { "text": { "pattern": "\\S" } } }
      ]
    },
    "contentBlock": { "oneOf": [
      {
        "type": "object", "additionalProperties": false, "required": ["type", "source"],
        "properties": {
          "type": { "const": "image" }, "title": { "$ref": "#/$defs/blockTitle" },
          "source": { "$ref": "#/$defs/imageSource" }, "caption": { "$ref": "#/$defs/blockText" },
          "height": { "type": "integer", "minimum": 64, "maximum": 1200 }
        }
      },
      {
        "type": "object", "additionalProperties": false, "required": ["type", "engine", "spec"],
        "properties": {
          "type": { "const": "chart" }, "title": { "$ref": "#/$defs/blockTitle" }, "engine": { "const": "vega_lite" },
          "spec": { "type": "object", "anyOf": [{ "required": ["mark"] }, { "required": ["layer"] }, { "required": ["hconcat"] }, { "required": ["vconcat"] }, { "required": ["concat"] }, { "required": ["facet"] }, { "required": ["repeat"] }] },
          "height": { "type": "integer", "minimum": 64, "maximum": 1200 }
        }
      },
      { "type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": { "type": { "const": "paragraph" }, "title": { "$ref": "#/$defs/blockTitle" }, "text": { "$ref": "#/$defs/blockText" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": { "type": { "const": "properties" }, "title": { "$ref": "#/$defs/blockTitle" }, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/propertyItem" } } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": { "type": { "const": "unordered_list" }, "title": { "$ref": "#/$defs/blockTitle" }, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/blockText" } } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": { "type": { "const": "ordered_list" }, "title": { "$ref": "#/$defs/blockTitle" }, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/blockText" } } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "progress" }, "title": { "$ref": "#/$defs/blockTitle" }, "value": { "type": "number", "minimum": 0, "maximum": 100 } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "fields"], "properties": { "type": { "const": "form" }, "title": { "$ref": "#/$defs/blockTitle" }, "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } } } }
    ] },
    "windowDimension": {
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "string", "pattern": "^(?:0?\\.[0-9]+|[1-9][0-9]?(?:\\.[0-9]+)?|100(?:\\.0+)?)%$" }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "label": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "type": { "enum": ["text", "textarea", "checkbox", "select", "radio_group", "number"] },
        "label": { "type": "string", "maxLength": 200 },
        "required": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "default": {},
        "min_length": { "type": "integer", "minimum": 0 },
        "max_length": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
        "style": { "enum": ["primary", "secondary", "danger"] },
        "submit": { "const": true },
        "result_status": { "enum": ["confirmed", "cancelled", "closed"] },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 }
      },
      "oneOf": [
        { "required": ["submit"], "not": { "required": ["result_status"] } },
        { "required": ["result_status"], "not": { "required": ["submit"] } }
      ]
    }
  }
}
